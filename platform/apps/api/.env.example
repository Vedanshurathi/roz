# Copy to .env for local development. On Render set these in the dashboard — never commit real values.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Supabase
SUPABASE_URL=https://srvpfyjmwaruebbkqkdj.supabase.co
SUPABASE_ANON_KEY=
# Server-only. Used for lookups that must never be exposed to browsers (e.g. vendor login email).
SUPABASE_SERVICE_ROLE_KEY=

# 64+ random hex characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Optional: the previous secret while rotating (sessions sealed with it still open, then get resealed)
SESSION_SECRET_PREVIOUS=

# Where this API is reachable from browsers, and which web apps may call it
PUBLIC_API_URL=http://localhost:8080
CUSTOMER_APP_URL=http://localhost:5173
VENDOR_APP_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Render / any proxy in front: number of proxy hops to trust for the client IP
TRUST_PROXY=1

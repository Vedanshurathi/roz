# RozBazaar vendor site (Hostinger). Upload next to index.html.
Options -Indexes
DirectoryIndex index.html

# always HTTPS (turn on SSL for the site in Hostinger first)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'sha256-tM9TGeJDaEWfMDr/HEDt12xG0VMpzieBCMuDrMqCTmU=' https://cdn.jsdelivr.net; style-src 'unsafe-inline'; img-src 'self' data: blob: https://srvpfyjmwaruebbkqkdj.supabase.co https://*.googleusercontent.com; connect-src https://srvpfyjmwaruebbkqkdj.supabase.co wss://srvpfyjmwaruebbkqkdj.supabase.co; base-uri 'none'; form-action 'none'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'"
  Header always set Cache-Control "no-cache, must-revalidate"
</IfModule>
